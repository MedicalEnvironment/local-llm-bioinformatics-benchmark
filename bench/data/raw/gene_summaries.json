l","mim":["131550"],"genomicinfo":[{"chrloc":"7","chraccver":"NC_000007.14","chrstart":55019016,"chrstop":55211627,"exoncount":32}],"geneweight":999999,"summary":"The protein encoded by this gene is a transmembrane glycoprotein that is a member of the protein kinase superfamily. This protein is a receptor for members of the epidermal growth factor family. EGFR is a cell surface protein that binds to epidermal growth factor, thus inducing receptor dimerization and tyrosine autophosphorylation leading to cell proliferation. Mutations in this gene are associated with lung cancer. EGFR is a component of the cytokine storm which contributes to a severe form of Coronavirus Disease 2019 (COVID-19) resulting from infection with severe acute respiratory syndrome coronavirus-2 (SARS-CoV-2). [provided by RefSeq, Jul 2020]","chrsort":"07","chrstart":55019016,"organism":{"scientificname":"Homo sapiens","commonname":"human","taxid":9606},"locationhist":[{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000007.14","chrstart":55019016,"chrstop":55211627},{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060931.1","chrstart":55178936,"chrstop":55372055},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000007.14","chrstart":55019016,"chrstop":55211627},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060931.1","chrstart":55178936,"chrstop":55372055},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000007.14","chrstart":55019016,"chrstop":55211627},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060931.1","chrstart":55178936,"chrstop":55372055},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000007.14","chrstart":55019016,"chrstop":55211627},{"annotationrelease":"RS_2023_03","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060931.1